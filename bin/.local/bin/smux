#!/usr/bin/env zsh
set -euo pipefail

## config
WORKAREAS=(
    ~/work
    ~/proj
)

## actions
usage()
{
    echo ""
    echo "Usage: $0 [-a|--append] [-h|--help]"
    echo ""
    echo "  --append    Create a new window in the current tmux session"
    echo "              instead of creating/switching sessions."
    echo ""
    echo "Using lookup folders: ${(j:, :)WORKAREAS}"
}

select_folder()
{
    {
        for dir in "${WORKAREAS[@]}"; do
            [[ -d "$dir" ]] && \
                find "$dir" -mindepth 1 -maxdepth 1 -type d
        done

        [[ -d ~/dotfiles ]] && realpath ~/dotfiles
    } | fzf
}

open_session()
{
    local folder
    folder=$(select_folder)
    [[ -z $folder ]] && exit 0

    local session_name
    session_name=$(basename "$folder" | tr . _)

    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Creating $session_name session..."
        local target_pane=$(
            tmux new-session -ds "$session_name" -c "$folder" -PF '#{session_name}:#{window_index}'
        )
        post_create_hook "$target_pane" "$folder"
    fi

    if [[ -z "${TMUX:-}" ]]; then
        tmux attach -t "$session_name"
    else
        tmux switch-client -t "$session_name"
    fi
}

append_window()
{
    local folder
    folder=$(select_folder)
    [[ -z $folder ]] && exit 0

    local session
    session=$(tmux display-message -p "#{session_name}")

    local window_name
    window_name=$(basename "$folder" | tr . _)

    local existing
    existing=$(tmux list-windows -t "$session" -F "#{window_name}:#{window_index}" | grep -m1 "^${window_name}:" || true)

    local target
    if [[ -n "$existing" ]]; then
        target="${session}:${existing#*:}"
    else
        target=$(tmux new-window -P -F "#{session_name}:#{window_index}" \
            -n "$window_name" \
            -c "$folder")
        post_create_hook "$target" "$folder"
    fi
    tmux select-window -t "$target"
}

post_create_hook()
{
    local target=$1
    local folder=$2

    if [[ -d "$folder/.venv" ]]; then
        tmux send-keys -t "$target" "source .venv/bin/activate" Enter
    fi
}

## main
case "${1:-}" in
    -h|--help)
        usage
        ;;
    -a|--append)
        [[ -z "${TMUX:-}" ]] && {
            echo "--append can only be used from inside a tmux session." >&2
            exit 1
        }
        append_window
        ;;
    "")
        open_session
        ;;
    *)
        echo "Unknown argument: $1" >&2
        usage
        exit 1
        ;;
esac
