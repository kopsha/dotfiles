#!/usr/bin/env zsh
set -euo pipefail

## config
WORKAREAS=(
    ~/work
    ~/proj
)

## actions
usage()
{
    echo ""
    echo "Usage: $0 [-h | --help]"
    echo "Description: Creates a new tmux session starting from the selected project folder."
    echo ""
    echo "Using lookup folders: ${(j:, :)WORKAREAS}"
}


open_session()
{
    local folder=$(
        {
            for dir in "${WORKAREAS[@]}"; do
                [[ -d "$dir" ]] && \
                    find "$dir" -mindepth 1 -maxdepth 1 -type d
            done

            [[ -d ~/dotfiles ]] && realpath ~/dotfiles
        } | fzf
    )
    [[ -z $folder ]] && exit 0

    local session_name=$(basename "$folder" | tr . _)

    if ! tmux has-session -t $session_name 2>/dev/null; then
        echo "Creating $session_name session..."
        tmux new-session -ds $session_name -c $folder
        post_create_hook $session_name "$folder"
    fi

    if [[ -z "${TMUX:-}" ]]; then
        tmux attach -t $session_name
    else
        tmux switch-client -t $session_name
    fi
}


post_create_hook()
{
    # NOTE: here we should invoke an auto-configuration script
    local target_session=$1
    local folder=$2
    if [[ -d "$folder/.venv" ]]; then
        tmux send-keys -t $target_session "source .venv/bin/activate" C-m
    fi
}

## main
arg=${1:-}
case $arg in
    -h|--help)
        usage
        exit
        ;;
    "")
        open_session
        ;;
    *)
        echo "Unknown argument: $arg" >&2
        usage
        exit -1
        ;;
esac
